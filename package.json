{
  "name": "yozora",
  "version": "0.0.2",
  "description": "A fluid, draggable floating tab bar for React.",
  "license": "MIT",
  "keywords": [
    "react",
    "navbar",
    "tab bar",
    "haptics",
    "navigation"
  ],
  "homepage": "https://github.com/theabmmohi/yozora",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theabmmohi/yozora.git"
  },
  "bugs": {
    "url": "https://github.com/theabmmohi/yozora/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles": "./dist/styles.css"
  },
  "files": ["dist"],
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "warn"
    }
  },
  "scripts": {
    "dev": "bunchee --watch",
    "build": "bunchee && cp src/styles.css dist/styles.css",
    "test": "echo \"Still No Test\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bunchee": "^7.0.1",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.2"
  }
}
