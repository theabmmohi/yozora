{
  "name": "yozora",
  "version": "1.0.0",
  "description": "A fluid, draggable floating tab bar for React.",
  "license": "MIT",
  "keywords": [
    "react",
    "navbar",
    "tab bar",
    "haptics",
    "navigation"
  ],
  "homepage": "https://github.com/theabmmohi/yozora",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theabmmohi/yozora.git"
  },
  "bugs": {
    "url": "https://github.com/theabmmohi/yozora/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/styles.css"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "warn"
    }
  },
  "scripts": {
    "dev": "bunchee --watch",
    "build": "bunchee && cp src/styles.css dist/styles.css && echo 'export {}' > dist/styles.d.ts",
    "test": "vitest run",
    "test:dist": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "@types/react": "^18.0.0 || ^19.0.0",
    "react": "^18.0.0 || ^19.0.0 || ^19.0.0-rc",
    "react-dom": "^18.0.0 || ^19.0.0 || ^19.0.0-rc"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bunchee": "^7.0.1",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.4"
  }
}
